{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    // JSX is configured on the vite side too (esbuild.jsx in the harness config).
    // Both are needed: vite's setting is what TRANSFORMS .tsx, this is what stops
    // tsc rejecting every one of them with TS17004 before it checks anything.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src"]
}
